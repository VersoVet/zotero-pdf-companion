{
  "manifest_version": 2,
  "name": "PDF Companion",
  "version": "4.14.0",
  "description": "Auto PDF fetch for Zotero (v4.14.0)",
  "author": "Onyx",
  "forge": {
    "type": "custom",
    "repository": "VersoVet/zotero-pdf-companion-plugin",
    "development": {
      "dev_platform": "dendrite",
      "test_platform": "verso-acqui",
      "remote_mount": true
    },
    "custom": {
      "target_app": "zotero",
      "build_output": "*.xpi",
      "components": [
        {
          "name": "extension",
          "type": "extension",
          "host": "172.16.0.2",
          "required_files": ["bootstrap.js", "pdfcompanion.js"]
        }
      ],
      "vault_keys": ["ssh_password"]
    }
  },
  "icons": {
    "48": "skin/icon.png",
    "96": "skin/icon@2x.png"
  },
  "applications": {
    "zotero": {
      "id": "pdf-companion@onyx.local",
      "update_url": "https://raw.githubusercontent.com/VersoVet/zotero-pdf-companion/main/updates.json",
      "strict_min_version": "6.999",
      "strict_max_version": "8.0.*"
    }
  },
  "core": {
    "brain_area": "bibliotheca",
    "routing": {
      "port": 0
    }
  },
  "heart": {
    "deployment": {
      "target_host": "172.16.0.2",
      "platform": "windows"
    },
    "lifecycle": {
      "run_mode": "extension",
      "auto_start": false
    }
  }
}
